rem Name of the server for the server list
sv.serverName "[LATAMSQUAD] #4 Eventos - latamsquad.org"
rem Password for joining the server
sv.password ""
rem 1 for internet servers, 0 for everything else
sv.internet 1
rem IPv4 of the server
sv.serverIP "172.84.94.108"
rem Port of the server
sv.serverPort 16570
rem Port to query server information
sv.gameSpyPort 29903
rem IPv4:Port of the mumble server to use. Leave empty to disable mumble
sv.voipServerRemoteIP "172.84.94.109:64740"
rem Message displayed in loading screen
sv.welcomeMessage "Bienvenido a LATAMSQUAD!|LEE LAS REGLAS en latamsquad.org o discord.gg/latamsquad|Comunicacion en espanol o ingles|Respeto ante todo! :)|No quieres esperar en la cola? Adquiere un pase VIP con slot reservado en latamsquad.org"
rem Message displayed in server browser. User '|' for line breaks and add 'pr_maplist' to add next maps in rotation
sv.sponsorText "Visita nuestro Discord para mas informacion! discord.gg/latamsquad"
rem Logo displayed in server browser
sv.sponsorLogoURL "https://i.imgur.com/TA1dPk7.png"
rem Logo displayed in server browser
sv.communityLogoURL "https://i.imgur.com/TA1dPk7.png"

sv.allowFreeCam 0
sv.allowExternalViews 0
sv.allowNoseCam 0
